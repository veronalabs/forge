{
  "name": "veronalabs/forge",
  "description": "VeronaLabs WordPress plugin starter template",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "VeronaLabs",
      "email": "dev@veronalabs.com",
      "homepage": "https://veronalabs.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "veronalabs/wp-scoper": "^1.2.4",
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "ForgeStarter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ForgeStarter\\Tests\\": "tests/"
    }
  },
  "extra": {
    "wp-scoper": {
      "namespace_prefix": "ForgeStarter\\Dependencies",
      "packages": [],
      "target_directory": "packages",
      "delete_vendor_packages": true,
      "exclude_directories": ["views", "templates", "resources", "public"]
    }
  },
  "scripts": {
    "test": "phpunit --testdox",
    "dist": "bash bin/build-zip.sh"
  },
  "config": {
    "platform-check": false,
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "veronalabs/wp-scoper": true
    }
  }
}
