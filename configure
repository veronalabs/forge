#!/usr/bin/env bash
set -euo pipefail

#
# Forge — VeronaLabs Plugin Starter
# Interactive configuration script
#
# Replaces all {{PLACEHOLDER}} tokens, renames files,
# sets up the premium plugin, and cleans up.
#

# ─── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ─── Helpers ─────────────────────────────────────────────────────────

print_header() {
    echo ""
    echo -e "${CYAN}${BOLD}⛏  Forge — VeronaLabs Plugin Starter${NC}"
    echo -e "${CYAN}   Craft production-ready WordPress plugins${NC}"
    echo ""
}

ask() {
    local prompt="$1"
    local default="$2"
    local result

    if [[ -n "$default" ]]; then
        echo -en "${BOLD}${prompt}${NC} ${YELLOW}[${default}]${NC}: " >&2
    else
        echo -en "${BOLD}${prompt}${NC}: " >&2
    fi

    read -r result
    echo "${result:-$default}"
}

# Derive slug from name: "WP Analytics" → "wp-analytics"
to_slug() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

# Derive namespace from name: "WP Analytics" → "WPAnalytics"
to_namespace() {
    echo "$1" | sed 's/[^a-zA-Z0-9 ]//g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1' | tr -d ' '
}

# Derive constant prefix from name: "WP Analytics" → "WP_ANALYTICS"
to_prefix() {
    echo "$1" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//'
}

# Derive short handle from name: "WP Analytics" → "wpanalytics"
to_short() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]//g'
}

# Derive hook prefix from name: "WP Analytics" → "wp_analytics"
to_hook() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//'
}

# Derive JS global variable: "WP Analytics" → "wpAnalyticsSettings"
to_js_global() {
    local words
    words=$(echo "$1" | sed 's/[^a-zA-Z0-9 ]/ /g')
    local first=true
    local result=""
    for word in $words; do
        if $first; then
            result=$(echo "$word" | tr '[:upper:]' '[:lower:]')
            first=false
        else
            result="${result}$(echo "${word:0:1}" | tr '[:lower:]' '[:upper:]')${word:1}"
        fi
    done
    echo "${result}Settings"
}

# ─── Main ────────────────────────────────────────────────────────────

print_header

# Ensure we're in the forge directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo -e "${GREEN}Answer the following questions to configure your plugin.${NC}"
echo -e "${GREEN}Press Enter to accept the default value shown in brackets.${NC}"
echo ""

# ─── Collect inputs ──────────────────────────────────────────────────

PLUGIN_NAME=$(ask "1. Plugin name (e.g., WP Analytics)" "")
if [[ -z "$PLUGIN_NAME" ]]; then
    echo -e "${RED}Error: Plugin name is required.${NC}"
    exit 1
fi

DEFAULT_SLUG=$(to_slug "$PLUGIN_NAME")
DEFAULT_NAMESPACE=$(to_namespace "$PLUGIN_NAME")
DEFAULT_PREFIX=$(to_prefix "$PLUGIN_NAME")
DEFAULT_SHORT=$(to_short "$PLUGIN_NAME")
DEFAULT_HOOK=$(to_hook "$PLUGIN_NAME")
DEFAULT_JS_GLOBAL=$(to_js_global "$PLUGIN_NAME")

PLUGIN_SLUG=$(ask "2. Plugin slug" "$DEFAULT_SLUG")
PLUGIN_NAMESPACE=$(ask "3. PHP namespace" "$DEFAULT_NAMESPACE")
PLUGIN_PREFIX=$(ask "4. Constant prefix" "$DEFAULT_PREFIX")
PLUGIN_SHORT=$(ask "5. Short handle (menu/CSS/JS)" "$DEFAULT_SHORT")
PLUGIN_HOOK=$(ask "6. Hook prefix (actions/filters)" "$DEFAULT_HOOK")
PLUGIN_JS_GLOBAL=$(ask "7. JS global variable" "$DEFAULT_JS_GLOBAL")
PLUGIN_DESCRIPTION=$(ask "8. Plugin description" "A WordPress plugin by VeronaLabs")
PLUGIN_URI=$(ask "9. Plugin URI" "https://veronalabs.com")
PLUGIN_VERSION=$(ask "10. Initial version" "1.0.0")
VITE_PORT=$(ask "11. Vite dev server port" "5173")
MIN_WP=$(ask "12. Minimum WordPress version" "6.0")
MIN_PHP=$(ask "13. Minimum PHP version" "7.4")

# ─── Confirm ─────────────────────────────────────────────────────────

echo ""
echo -e "${CYAN}${BOLD}Configuration summary:${NC}"
echo -e "  Plugin name:     ${BOLD}${PLUGIN_NAME}${NC}"
echo -e "  Slug:            ${PLUGIN_SLUG}"
echo -e "  Namespace:       ${PLUGIN_NAMESPACE}"
echo -e "  Prefix:          ${PLUGIN_PREFIX}"
echo -e "  Short handle:    ${PLUGIN_SHORT}"
echo -e "  Hook prefix:     ${PLUGIN_HOOK}"
echo -e "  JS global:       ${PLUGIN_JS_GLOBAL}"
echo -e "  Description:     ${PLUGIN_DESCRIPTION}"
echo -e "  URI:             ${PLUGIN_URI}"
echo -e "  Version:         ${PLUGIN_VERSION}"
echo -e "  Vite port:       ${VITE_PORT}"
echo -e "  Min WordPress:   ${MIN_WP}"
echo -e "  Min PHP:         ${MIN_PHP}"
echo ""

CONFIRM=$(ask "Proceed? (y/n)" "y")
if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
    echo -e "${YELLOW}Aborted.${NC}"
    exit 0
fi

echo ""
echo -e "${GREEN}Configuring...${NC}"

# ─── Replace placeholders ───────────────────────────────────────────

# Escape special characters for sed
SED_PLUGIN_URI=$(printf '%s\n' "$PLUGIN_URI" | sed 's/[&/\]/\\&/g')
SED_PLUGIN_DESCRIPTION=$(printf '%s\n' "$PLUGIN_DESCRIPTION" | sed 's/[&/\]/\\&/g')

# Find all template files (excluding .git, node_modules, vendor)
FILES=$(find . -type f \
    -not -path './.git/*' \
    -not -path './node_modules/*' \
    -not -path './vendor/*' \
    -not -path './packages/*' \
    -not -name 'configure')

for file in $FILES; do
    if file "$file" | grep -qE 'text|JSON|XML'; then
        sed -i '' \
            -e "s/{{PLUGIN_NAME}}/${PLUGIN_NAME}/g" \
            -e "s/{{PLUGIN_SLUG}}/${PLUGIN_SLUG}/g" \
            -e "s/{{PLUGIN_NAMESPACE}}/${PLUGIN_NAMESPACE}/g" \
            -e "s/{{PLUGIN_PREFIX}}/${PLUGIN_PREFIX}/g" \
            -e "s/{{PLUGIN_SHORT}}/${PLUGIN_SHORT}/g" \
            -e "s/{{PLUGIN_HOOK}}/${PLUGIN_HOOK}/g" \
            -e "s/{{PLUGIN_JS_GLOBAL}}/${PLUGIN_JS_GLOBAL}/g" \
            -e "s/{{PLUGIN_DESCRIPTION}}/${SED_PLUGIN_DESCRIPTION}/g" \
            -e "s|{{PLUGIN_URI}}|${PLUGIN_URI}|g" \
            -e "s/{{PLUGIN_VERSION}}/${PLUGIN_VERSION}/g" \
            -e "s/{{VITE_PORT}}/${VITE_PORT}/g" \
            -e "s/{{MIN_WP}}/${MIN_WP}/g" \
            -e "s/{{MIN_PHP}}/${MIN_PHP}/g" \
            "$file" 2>/dev/null || true
    fi
done

echo -e "  ${GREEN}✓${NC} Replaced placeholders"

# ─── Rename main plugin file ────────────────────────────────────────

mv "plugin-name.php" "${PLUGIN_SLUG}.php"
echo -e "  ${GREEN}✓${NC} Renamed plugin-name.php → ${PLUGIN_SLUG}.php"

# ─── Update composer package name ────────────────────────────────────

sed -i '' "s|veronalabs/forge|veronalabs/${PLUGIN_SLUG}|g" composer.json
sed -i '' "s|\"type\": \"project\"|\"type\": \"wordpress-plugin\"|g" composer.json
echo -e "  ${GREEN}✓${NC} Updated composer.json"

# ─── Set up premium plugin ──────────────────────────────────────────

PREMIUM_DIR="../${PLUGIN_SLUG}-premium"

if [[ -d "premium" ]]; then
    # Copy premium template to sibling directory
    cp -r premium/ "$PREMIUM_DIR"

    # Rename main premium file
    mv "${PREMIUM_DIR}/plugin-name-premium.php" "${PREMIUM_DIR}/${PLUGIN_SLUG}-premium.php"

    # Create symlinks in premium directory pointing to free plugin files
    PLUGIN_DIR="$(basename "$(pwd)")"
    cd "$PREMIUM_DIR"

    # Symlink shared directories from free plugin
    for dir in src views resources; do
        if [[ -d "../${PLUGIN_DIR}/${dir}" ]]; then
            ln -sf "../${PLUGIN_DIR}/${dir}" "${dir}"
        fi
    done

    # Symlink shared files from free plugin
    for file in package.json vite.config.js vite.config.entries.mjs phpunit.xml.dist .editorconfig; do
        if [[ -f "../${PLUGIN_DIR}/${file}" ]]; then
            ln -sf "../${PLUGIN_DIR}/${file}" "${file}"
        fi
    done

    # Create modules directory for premium features
    mkdir -p pro/modules

    cd "$SCRIPT_DIR"

    # Remove premium template from free plugin
    rm -rf premium/

    echo -e "  ${GREEN}✓${NC} Created premium plugin at ${PREMIUM_DIR}/"
    echo -e "  ${GREEN}✓${NC} Set up symlinks from premium → free"
fi

# ─── Clean up ────────────────────────────────────────────────────────

# Remove this configure script
rm -f configure

# Remove forge README (user will write their own)
rm -f README.md

echo -e "  ${GREEN}✓${NC} Cleaned up scaffolding files"

# ─── Initialize git ─────────────────────────────────────────────────

if [[ ! -d .git ]]; then
    git init -q
    echo -e "  ${GREEN}✓${NC} Initialized git repository"
fi

# ─── Done ────────────────────────────────────────────────────────────

echo ""
echo -e "${GREEN}${BOLD}Done!${NC} Your plugin is ready."
echo ""
echo -e "${BOLD}Next steps:${NC}"
echo ""
echo -e "  ${CYAN}# Install PHP dependencies${NC}"
echo -e "  composer install"
echo ""
echo -e "  ${CYAN}# Install frontend dependencies${NC}"
echo -e "  npm install"
echo ""
echo -e "  ${CYAN}# Start development${NC}"
echo -e "  npm run dev"
echo ""
echo -e "  ${CYAN}# Run tests${NC}"
echo -e "  composer test"
echo ""

if [[ -d "$PREMIUM_DIR" ]]; then
    echo -e "${BOLD}Premium plugin:${NC}"
    echo -e "  ${PREMIUM_DIR}/"
    echo ""
fi
